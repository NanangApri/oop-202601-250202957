    Aset ..|> DapatDipinjam : implements
    Ruang --|> Aset : extends
    Laptop --|> Aset : extends
    AlatLab --|> Aset : extends

    Peminjaman "*" --> "1" Peminjam : meminjam
    Peminjaman "*" --> "1" Aset : untuk
    KatalogAset "1" o-- "0..*" Aset : menyimpan
    JadwalPeminjaman "1" o-- "0..*" Peminjaman : menjadwalkan

    DendaFlat ..|> AturanDenda : implements
    DendaProgresif ..|> AturanDenda : implements
    LayananDenda ..> AturanDenda : memakai
    LayananDenda ..> Aset : menghitung
    DendaFlat ..> Aset : menghitung
    DendaProgresif ..> Aset : menghitung
    Aset ..> Varian : membaca tarif

    AsetFactory ..> Aset : membuat
    AsetFactory ..> JenisAset : memilih jenis

    JdbcAsetDAO ..|> AsetDAO : implements
    JdbcPeminjamanDAO ..|> PeminjamanDAO : implements
    JdbcPeminjamanDAO --> "1" AsetDAO : memuat aset
    Koneksi ..> DataAksesException : membungkus

    DataAksesException --|> AsetPinjamException : extends
    KuotaHabisException --|> AsetPinjamException : extends
    PeminjamanBentrokException --|> AsetPinjamException : extends
    StatusTidakSahException --|> AsetPinjamException : extends
